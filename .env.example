ANTHROPIC_API_KEY=sk-ant-api03-your_key_here

# Name shown in the UI and used in the system prompt
COMPANY_NAME=Baabaa Coding Limited

# Claude model to use (haiku is fastest/cheapest; swap for sonnet/opus for higher quality)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Number of document chunks retrieved per question (increase if answers are incomplete)
RETRIEVAL_K=10

# Hugging Face token — required to download embedding models (get one free at https://huggingface.co/settings/tokens)
HUGGINGFACEHUB_API_TOKEN=hf_your_token_here
